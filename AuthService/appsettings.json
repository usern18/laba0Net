{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=miniproject_auth.db"
  },
  "Jwt": {
    "Issuer": "MiniProject.Auth",
    "Audience": "MiniProject.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}