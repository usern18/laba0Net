{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Orders": "Data Source=ordering.db"
  },
  "CatalogApi": {
    "BaseUrl": "http://localhost:5002/",
    "HealthPath": "health"
  },
  "Jwt": {
    "Issuer": "MiniProject.Auth",
    "Audience": "MiniProject.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
